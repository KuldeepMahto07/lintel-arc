{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/signup", "destination": "https://lintel-ruddy-five.vercel.app/signup" },
    { "source": "/login", "destination": "https://lintel-ruddy-five.vercel.app/login" },
    { "source": "/reset", "destination": "https://lintel-ruddy-five.vercel.app/reset" },
    { "source": "/invite/:path*", "destination": "https://lintel-ruddy-five.vercel.app/invite/:path*" },
    { "source": "/app", "destination": "https://lintel-ruddy-five.vercel.app/app" },
    { "source": "/app/:path*", "destination": "https://lintel-ruddy-five.vercel.app/app/:path*" },
    { "source": "/api/:path*", "destination": "https://lintel-ruddy-five.vercel.app/api/:path*" },
    { "source": "/static/:path*", "destination": "https://lintel-ruddy-five.vercel.app/static/:path*" }
  ]
}
